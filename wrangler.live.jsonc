// LIVE Tap Am at https://tapammm.live — real players, real money.
// A separate Worker ("tapammm-live") with its own database, so the preview and the old
// "nak-am" Worker are never touched.
//   npx wrangler deploy -c wrangler.live.jsonc
// Secrets (set in the Cloudflare dashboard → tapammm-live → Settings → Variables and Secrets):
//   PAYSTACK_SECRET_KEY  live secret key from Paystack (Settings → API Keys & Webhooks);
//                        Paystack webhook URL: https://tapammm.live/api/paystack/webhook
//   SEED_KEY             long random text; encrypts the recovery-phrase backup copies
//   OTP_PEPPER           long random text; signs email codes and unsubscribe links
//   ADMIN_SETUP_KEY      long random text; used once to create the super admin
// Never add OTP_DEV_MODE or PAYMENTS_TEST_MODE here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapammm-live",
  "main": "src/worker.js",
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "PUBLIC_URL": "https://tapammm.live" },
  // tapammm.live must be added to this Cloudflare account first (nameservers moved from Namecheap).
  "routes": [
    { "pattern": "tapammm.live", "custom_domain": true },
    { "pattern": "www.tapammm.live", "custom_domain": true }
  ],
  // Every 5 minutes: settle any ended pool whose room alarm didn't run, send email blasts, tidy old rows.
  "triggers": { "crons": ["*/5 * * * *"] },
  "placement": { "mode": "smart" },
  "durable_objects": { "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }, { "name": "TAP_METER", "class_name": "TapMeter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }, { "tag": "v2", "new_sqlite_classes": ["TapMeter"] }],
  // Sponsor ad pictures and logos: switch on R2 in the dashboard, create the bucket, then uncomment.
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tapammm-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tapammm-live",
      "database_id": "8332109e-67cc-4878-a964-d1ef5d3c0bc3"
    }
  ]
}
