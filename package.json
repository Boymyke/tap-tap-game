{
  "name": "nak-am",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute nak-am --remote --file=schema.sql",
    "db:local": "wrangler d1 execute nak-am --local --file=schema.sql",
    "db:upgrade": "wrangler d1 execute nak-am --remote --file=migrations/0001_signup_fields.sql",
    "db:upgrade:local": "wrangler d1 execute nak-am --local --file=migrations/0001_signup_fields.sql",
    "preview:deploy": "wrangler deploy -c wrangler.preview.jsonc",
    "preview:dev": "wrangler dev -c wrangler.preview.jsonc",
    "db:upgrade:2": "wrangler d1 execute nak-am --remote --file=migrations/0002_email_codes.sql",
    "db:upgrade:2:local": "wrangler d1 execute nak-am --local --file=migrations/0002_email_codes.sql",
    "db:upgrade:3": "wrangler d1 execute nak-am --remote --file=migrations/0003_landing.sql",
    "db:upgrade:3:local": "wrangler d1 execute nak-am --local --file=migrations/0003_landing.sql",
    "db:upgrade:4": "wrangler d1 execute nak-am --remote --file=migrations/0004_full_game.sql",
    "db:upgrade:4:local": "wrangler d1 execute nak-am --local --file=migrations/0004_full_game.sql",
    "db:upgrade:5": "wrangler d1 execute nak-am --remote --file=migrations/0005_tiers_sponsors_stats.sql",
    "db:upgrade:5:local": "wrangler d1 execute nak-am --local --file=migrations/0005_tiers_sponsors_stats.sql",
    "preview:db:upgrade:5": "wrangler d1 execute tap-am-ui-preview --remote -c wrangler.preview.jsonc --file=migrations/0005_tiers_sponsors_stats.sql",
    "brand": "node scripts/brand.mjs",
    "build:share": "node scripts/build-share.mjs",
    "db:upgrade:6": "wrangler d1 execute nak-am --remote --file=migrations/0006_patterns_merch_badges.sql",
    "db:upgrade:6:local": "wrangler d1 execute nak-am --local --file=migrations/0006_patterns_merch_badges.sql",
    "preview:db:upgrade:6": "wrangler d1 execute tap-am-ui-preview --remote -c wrangler.preview.jsonc --file=migrations/0006_patterns_merch_badges.sql",
    "db:upgrade:7": "wrangler d1 execute nak-am --remote --file=migrations/0007_money_boxes_codes_phrases.sql",
    "db:upgrade:7:local": "wrangler d1 execute nak-am --local --file=migrations/0007_money_boxes_codes_phrases.sql",
    "preview:db:upgrade:7": "wrangler d1 execute tap-am-ui-preview --remote -c wrangler.preview.jsonc --file=migrations/0007_money_boxes_codes_phrases.sql"
  },
  "devDependencies": {
    "wrangler": "^4.68.0"
  }
}
