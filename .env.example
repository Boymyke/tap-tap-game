DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
SETTINGS_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
AUDIT_PEPPER=replace-with-another-random-secret
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=use-a-very-strong-14-plus-character-password
# Optional: comma-separated exact IPs allowed to access admin login
ADMIN_IP_ALLOWLIST=
