// Preview deployment for testing the new Tap Am UI.
// Deploys to a separate Worker ("tap-am-ui-preview") with its own empty D1 database,
// so the live "nak-am" Worker and its data are never touched.
//   npm run preview:deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tap-am-ui-preview",
  "main": "src/worker.js",
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Test mode: until an email service is connected, sign-up/reset codes are shown on
  // screen instead of emailed. Never set this on the live Worker.
  // PAYMENTS_TEST_MODE: wallet funding and Nepo card payments are simulated until a
  // Paystack key is added as a secret (PAYSTACK_SECRET_KEY). Never set this on the live Worker.
  "vars": { "OTP_DEV_MODE": "1", "PAYMENTS_TEST_MODE": "1" },
  // Every 5 minutes: settle any ended pool whose room alarm didn't run, and tidy old rows.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Runs the worker close to the database: pages that read several things load faster.
  "placement": { "mode": "smart" },
  // One GameRoom per pool keeps live scores and settles the pool when it ends.
  // One TapMeter per player counts taps for daily/monthly limits (only when the admin turns limits on).
  "durable_objects": { "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }, { "name": "TAP_METER", "class_name": "TapMeter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }, { "tag": "v2", "new_sqlite_classes": ["TapMeter"] }],
  // Sponsor ad pictures, tap skins and logos live in R2. R2 must be switched on in the
  // Cloudflare dashboard first; then create the bucket and uncomment this line:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tap-am-media-preview" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tap-am-ui-preview",
      "database_id": "8b06ac2c-47da-449e-a2c2-9490498aca81"
    }
  ]
}
